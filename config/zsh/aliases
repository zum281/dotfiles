# eza aliases
alias ls="eza --color=always -l --all --git --icons=always --no-time --no-user"
alias tree="eza --tree --color=always --all --icons=always --git --no-filesize --no-time --no-user --no-permissions --level=3"

alias type='type -a'
alias grep='grep --color=auto'

# application aliases
alias c='claude'
alias vi='nvim'

# git aliases
alias g='git'
alias gd='git diff --output-indicator-new=" " --output-indicator-old=" "'
alias ga='git add'
alias gap='git add -p'
alias gus='git restore --staged'
alias gc='git commit'
alias gcm='git commit -m'
alias gca='git commit --amend'
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gu='git pull'
alias gsw='git switch'
alias gs='git status'
alias lg='git status'
alias gl='git log --graph --oneline --decorate --all'
alias gb='git branch -vv --sort=-committerdate'
alias gsh='git stash list'
alias gshu='git stash -u'

# npm aliases
alias nd="npm run dev"
alias nn="npm run check && npm run lint && npm run test"

# custom scripts aliases
alias cb="clean-branches"
