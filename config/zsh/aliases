# use bat instead of cat
alias cat='bat'

# eza aliases
alias ls="eza --color=always -l --all --git --icons=always --no-time --no-user"
alias tree="eza --tree --color=always --all --icons=always --git --no-filesize --no-time --no-user --no-permissions --level=3"

alias type='type -a'
alias grep='grep --color=auto'

# application aliases
alias vi='nvim'
alias lg='lazygit'
alias lldb='/opt/homebrew/opt/llvm/bin/lldb'
alias /='is-fast'

# git aliases
alias g='git'
alias gdiff='git diff --output-indicator-new=" " --output-indicator-old=" "'
alias gp='git push --force-with-lease'
alias gu='git pull'
alias gsw='git switch'

# npm aliases
alias nd="npm run dev"
alias nn="npm run check && npm run lint && npm run test"

# custom scripts aliases
alias cb="clean-branches"


