[delta]
	syntax-theme = ember
	minus-style = syntax "#2a1a17"
	minus-emph-style = syntax "#4a2420"
	plus-style = syntax "#1c2417"
	plus-emph-style = syntax "#2f3d22"
	line-numbers-minus-style = "#fa7883"
	line-numbers-plus-style = "#98c379"
	line-numbers-zero-style = "#888888"
	hunk-header-decoration-style = "#888888" box
	file-style = "#ff9470" bold
	file-decoration-style = "#888888" ul
	commit-decoration-style = "#ff9470" box
	blame-palette = "#000000" "#1a1714" "#585858"
