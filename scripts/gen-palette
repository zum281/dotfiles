#!/usr/bin/env bash
# Single source of truth: render every tool's palette from a base16 palette
# file in config/palettes/<name>.lua. Pass a name to switch palettes (this
# overwrites config/nvim/lua/zusk/palette.lua too, so nvim stays in sync);
# omit it to just re-render the currently active one.
#   - config/nvim/lua/zusk/palette.lua (require("zusk.palette") in nvim)
#   - config/fzf/opts            (FZF_DEFAULT_OPTS_FILE)
#   - config/wezterm/palette.lua (required by wezterm.lua)
#   - config/git/delta.gitconfig ([include] in gitconfig-shared)
#   - config/lazygit/config.yml
#   - config/zsh/palette.zsh     (sourced by home/zshrc and home/bashrc)
# Not generated (full-file artifacts, hand-maintained): config/bat/themes/ember.tmTheme.
# It is already palette-correct; update by hand if the palette changes.

log_info() { printf "%sℹ%s gen-palette: %s\n" "$(tput setaf 4)" "$(tput sgr0)" "$*"; }
log_ok()   { printf "%s✓%s gen-palette: %s\n" "$(tput setaf 2)" "$(tput sgr0)" "$*"; }
log_err()  { printf "%s✗%s gen-palette: %s\n" "$(tput setaf 1)" "$(tput sgr0)" "$*" >&2; }

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
palettes_dir="$repo/config/palettes"
nvim_palette="$repo/config/nvim/lua/zusk/palette.lua"

if [[ "${1:-}" == "list" ]]; then
  for f in "$palettes_dir"/*.lua; do
    basename "$f" .lua
  done
  exit 0
fi

name="${1:-}"
if [[ -z "$name" ]]; then
  name="$(sed -nE 's#^-- Generated by scripts/gen-palette from config/palettes/(.*)\.lua.*#\1#p' "$nvim_palette")"
fi
palette="$palettes_dir/$name.lua"
[[ -f "$palette" ]] || {
  log_err "no palette named '$name' in $palettes_dir (see: gen-palette list)"
  exit 1
}

declare -A C
while read -r k v; do C[$k]="$v"; done < <(
  sed -nE 's/^[[:space:]]*(base[0-9A-Fa-f]+)[[:space:]]*=[[:space:]]*"(#[0-9A-Fa-f]+)".*/\1 \2/p' "$palette"
)
[[ -n "${C[base00]:-}" && -n "${C[base0F]:-}" ]] || {
  log_err "failed to parse $palette"
  exit 1
}
log_info "switching to '$name'"

# Decimal RGB counterpart of every hex color, for terminals (bash PS1) that
# want `\e[38;2;R;G;Bm` instead of a hex code.
declare -A R
for k in "${!C[@]}"; do
  hex="${C[$k]#\#}"
  R[$k]="$((16#${hex:0:2}));$((16#${hex:2:2}));$((16#${hex:4:2}))"
done

# ---------------------------------------------------------------- nvim
mkdir -p "$repo/config/nvim/lua/zusk"
{
  echo "-- base16: $name"
  echo "-- Generated by scripts/gen-palette from config/palettes/$name.lua — to switch"
  echo "-- palettes, run \`scripts/gen-palette <name>\` (see: gen-palette list)."
  echo "return {"
  for k in base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F; do
    printf '\tbase%s = "%s",\n' "${k#base}" "${C[$k]}"
  done
  echo "}"
} >"$nvim_palette"

# ---------------------------------------------------------------- fzf
mkdir -p "$repo/config/fzf"
cat >"$repo/config/fzf/opts" <<EOF
--height=~50%
--layout=reverse
--border=none
--info=right
--highlight-line
--preview-window=border-left
--prompt='  '
--pointer='▌'
--marker='+'
--separator='─'
--scrollbar='▏'
--ellipsis='…'
--cycle
--color=bg:${C[base00]},fg:${C[base05]},bg+:${C[base00]},fg+:${C[base0A]}:bold,hl:${C[base0A]}:bold,hl+:${C[base0A]}:bold,gutter:${C[base00]},border:${C[base02]},preview-border:${C[base02]},separator:${C[base02]},scrollbar:${C[base02]},label:${C[base0A]},header:${C[base0A]},info:${C[base04]},prompt:${C[base0A]},pointer:${C[base0A]},marker:${C[base0B]},selected-bg:${C[base02]},selected-fg:${C[base09]},query:${C[base07]},spinner:${C[base0B]}
EOF

# ---------------------------------------------------------------- wezterm
mkdir -p "$repo/config/wezterm"
cat >"$repo/config/wezterm/palette.lua" <<EOF
return {
	foreground = "${C[base05]}",
	background = "${C[base00]}",
	cursor_bg = "${C[base0A]}",
	cursor_border = "${C[base0A]}",
	cursor_fg = "${C[base00]}",
	selection_fg = "${C[base06]}",
	selection_bg = "${C[base02]}",
	ansi = { "${C[base00]}", "${C[base08]}", "${C[base0B]}", "${C[base0A]}", "${C[base0D]}", "${C[base0E]}", "${C[base0C]}", "${C[base05]}" },
	brights = { "${C[base03]}", "${C[base08]}", "${C[base0B]}", "${C[base0A]}", "${C[base0D]}", "${C[base0E]}", "${C[base0C]}", "${C[base07]}" },
	tab_bar = {
		background = "${C[base00]}",
		active_tab = { bg_color = "${C[base00]}", fg_color = "${C[base0A]}" },
		inactive_tab = { bg_color = "${C[base00]}", fg_color = "${C[base05]}" },
		new_tab = { bg_color = "${C[base00]}", fg_color = "${C[base05]}" },
	},
}
EOF

# ---------------------------------------------------------------- delta (git)
mkdir -p "$repo/config/git"
cat >"$repo/config/git/delta.gitconfig" <<EOF
[delta]
	syntax-theme = ember
	minus-style = syntax "#2a1a17"
	minus-emph-style = syntax "#4a2420"
	plus-style = syntax "#1c2417"
	plus-emph-style = syntax "#2f3d22"
	line-numbers-minus-style = "${C[base08]}"
	line-numbers-plus-style = "${C[base0B]}"
	line-numbers-zero-style = "${C[base03]}"
	hunk-header-decoration-style = "${C[base03]}" box
	file-style = "${C[base0A]}" bold
	file-decoration-style = "${C[base03]}" ul
	commit-decoration-style = "${C[base0A]}" box
	blame-palette = "${C[base00]}" "#1a1714" "${C[base02]}"
EOF

# ---------------------------------------------------------------- lazygit
mkdir -p "$repo/config/lazygit"
cat >"$repo/config/lazygit/config.yml" <<EOF
gui:
  expandFocusedSidePanel: true
  expandedSidePanelWeight: 2
  timeFormat: 02 Jan 2006
  shortTimeFormat: 13:04
  theme:
    activeBorderColor:
      - '${C[base0A]}'
      - bold
    inactiveBorderColor:
      - '${C[base03]}'
    searchingActiveBorderColor:
      - '${C[base09]}'
      - bold
    optionsTextColor:
      - '${C[base04]}'
    selectedLineBgColor:
      - '${C[base02]}'
    cherryPickedCommitBgColor:
      - '${C[base0A]}'
    cherryPickedCommitFgColor:
      - '${C[base00]}'
    unstagedChangesColor:
      - '${C[base08]}'
    defaultFgColor:
      - '${C[base05]}'
  commitLength:
    show: true
  showListFooter: false
  fileTreeSortOrder: mixed
  showNumstatInFilesView: true
  showRandomTip: false
  showCommandLog: false
  showBottomLine: false
  showPanelJumps: true
  showDivergenceFromBaseBranch: arrowAndNumber
  filterMode: fuzzy
  statusPanelView: allBranchesLog
git:
  pagers:
    - colorArg: always
      pager: delta --paging=never
  branchLogCmd: git log --graph --color=always --abbrev-commit --decorate --date=relative --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(dim white)(%cr) %C(blue)<%an>%Creset' {{branchName}} --
  log:
    showWholeGraph: true
notARepository: quit
disableStartupPopups: true
EOF

# ---------------------------------------------------------------- shell prompts (zsh + bash)
mkdir -p "$repo/config/zsh"
{
  echo "# Generated by scripts/gen-palette from config/palettes/$name.lua — do not edit by hand."
  echo "# HEX vars for zsh (%F{\$VAR}), RGB vars for bash (\\e[38;2;\${VAR}m)."
  for k in base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F; do
    upper="${k^^}"
    printf 'export P_%s_HEX="%s"\n' "$upper" "${C[$k]}"
    printf 'export P_%s_RGB="%s"\n' "$upper" "${R[$k]}"
  done
} >"$repo/config/zsh/palette.zsh"

log_ok "wrote nvim, fzf, wezterm, delta, lazygit, zsh palette ($name)"
