#!/usr/bin/env bash
# Single source of truth: render every tool's palette from a base16 palette
# file in config/palettes/<name>.lua. Pass a name to switch palettes (this
# overwrites config/nvim/lua/zusk/palette.lua too, so nvim stays in sync);
# omit it to just re-render the currently active one.
#   - config/nvim/lua/zusk/palette.lua (require("zusk.palette") in nvim)
#   - config/fzf/opts            (FZF_DEFAULT_OPTS_FILE)
#   - config/wezterm/palette.lua (required by wezterm.lua)
#   - config/git/delta.gitconfig ([include] in gitconfig-shared)
#   - config/lazygit/config.yml
#   - config/zsh/palette.zsh     (sourced by home/zshrc and home/bashrc)
#   - config/is-fast/config.toml (only its color keys; other sections are
#     hand-maintained and left untouched — see comment above that block)
#   - config/superfile/theme/dotfiles.toml
# Not generated (full-file artifacts, hand-maintained): config/bat/themes/ember.tmTheme.
# It is already palette-correct; update by hand if the palette changes.

log_info() { printf "%sℹ%s gen-palette: %s\n" "$(tput setaf 4)" "$(tput sgr0)" "$*"; }
log_ok()   { printf "%s✓%s gen-palette: %s\n" "$(tput setaf 2)" "$(tput sgr0)" "$*"; }
log_err()  { printf "%s✗%s gen-palette: %s\n" "$(tput setaf 1)" "$(tput sgr0)" "$*" >&2; }

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
palettes_dir="$repo/config/palettes"
nvim_palette="$repo/config/nvim/lua/zusk/palette.lua"

if [[ "${1:-}" == "list" ]]; then
  for f in "$palettes_dir"/*.lua; do
    basename "$f" .lua
  done
  exit 0
fi

name="${1:-}"
if [[ -z "$name" ]]; then
  name="$(sed -nE 's#^-- Generated by scripts/gen-palette from config/palettes/(.*)\.lua.*#\1#p' "$nvim_palette")"
fi
palette="$palettes_dir/$name.lua"
[[ -f "$palette" ]] || {
  log_err "no palette named '$name' in $palettes_dir (see: gen-palette list)"
  exit 1
}

declare -A C
while read -r k v; do C[$k]="$v"; done < <(
  sed -nE 's/^[[:space:]]*(base[0-9A-Fa-f]+)[[:space:]]*=[[:space:]]*"(#[0-9A-Fa-f]+)".*/\1 \2/p' "$palette"
)
[[ -n "${C[base00]:-}" && -n "${C[base0F]:-}" ]] || {
  log_err "failed to parse $palette"
  exit 1
}
log_info "switching to '$name'"

# Decimal RGB counterpart of every hex color, for terminals (bash PS1) that
# want `\e[38;2;R;G;Bm` instead of a hex code.
declare -A R
for k in "${!C[@]}"; do
  hex="${C[$k]#\#}"
  R[$k]="$((16#${hex:0:2}));$((16#${hex:2:2}));$((16#${hex:4:2}))"
done

# ---------------------------------------------------------------- nvim
mkdir -p "$repo/config/nvim/lua/zusk"
{
  echo "-- base16: $name"
  echo "-- Generated by scripts/gen-palette from config/palettes/$name.lua — to switch"
  echo "-- palettes, run \`scripts/gen-palette <name>\` (see: gen-palette list)."
  echo "return {"
  for k in base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F; do
    printf '\tbase%s = "%s",\n' "${k#base}" "${C[$k]}"
  done
  echo "}"
} >"$nvim_palette"

# ---------------------------------------------------------------- fzf
mkdir -p "$repo/config/fzf"
cat >"$repo/config/fzf/opts" <<EOF
--height=~50%
--layout=reverse
--border=none
--info=right
--highlight-line
--preview-window=border-left
--prompt='  '
--pointer='▌'
--marker='+'
--separator='─'
--scrollbar='▏'
--ellipsis='…'
--cycle
--color=bg:${C[base00]},fg:${C[base05]},bg+:${C[base00]},fg+:${C[base0A]}:bold,hl:${C[base0A]}:bold,hl+:${C[base0A]}:bold,gutter:${C[base00]},border:${C[base02]},preview-border:${C[base02]},separator:${C[base02]},scrollbar:${C[base02]},label:${C[base0A]},header:${C[base0A]},info:${C[base04]},prompt:${C[base0A]},pointer:${C[base0A]},marker:${C[base0B]},selected-bg:${C[base02]},selected-fg:${C[base09]},query:${C[base07]},spinner:${C[base0B]}
EOF

# ---------------------------------------------------------------- wezterm
mkdir -p "$repo/config/wezterm"
cat >"$repo/config/wezterm/palette.lua" <<EOF
return {
	foreground = "${C[base05]}",
	background = "${C[base00]}",
	cursor_bg = "${C[base0A]}",
	cursor_border = "${C[base0A]}",
	cursor_fg = "${C[base00]}",
	selection_fg = "${C[base06]}",
	selection_bg = "${C[base02]}",
	ansi = { "${C[base00]}", "${C[base08]}", "${C[base0B]}", "${C[base0A]}", "${C[base0D]}", "${C[base0E]}", "${C[base0C]}", "${C[base05]}" },
	brights = { "${C[base03]}", "${C[base08]}", "${C[base0B]}", "${C[base0A]}", "${C[base0D]}", "${C[base0E]}", "${C[base0C]}", "${C[base07]}" },
	tab_bar = {
		background = "${C[base00]}",
		active_tab = { bg_color = "${C[base00]}", fg_color = "${C[base0A]}" },
		inactive_tab = { bg_color = "${C[base00]}", fg_color = "${C[base05]}" },
		new_tab = { bg_color = "${C[base00]}", fg_color = "${C[base05]}" },
	},
}
EOF

# ---------------------------------------------------------------- delta (git)
mkdir -p "$repo/config/git"
cat >"$repo/config/git/delta.gitconfig" <<EOF
[delta]
	syntax-theme = ember
	minus-style = syntax "#2a1a17"
	minus-emph-style = syntax "#4a2420"
	plus-style = syntax "#1c2417"
	plus-emph-style = syntax "#2f3d22"
	line-numbers-minus-style = "${C[base08]}"
	line-numbers-plus-style = "${C[base0B]}"
	line-numbers-zero-style = "${C[base03]}"
	hunk-header-decoration-style = "${C[base03]}" box
	file-style = "${C[base0A]}" bold
	file-decoration-style = "${C[base03]}" ul
	commit-decoration-style = "${C[base0A]}" box
	blame-palette = "${C[base00]}" "#1a1714" "${C[base02]}"
EOF

# ---------------------------------------------------------------- lazygit
mkdir -p "$repo/config/lazygit"
cat >"$repo/config/lazygit/config.yml" <<EOF
gui:
  expandFocusedSidePanel: true
  expandedSidePanelWeight: 2
  timeFormat: 02 Jan 2006
  shortTimeFormat: 13:04
  theme:
    activeBorderColor:
      - '${C[base0A]}'
      - bold
    inactiveBorderColor:
      - '${C[base03]}'
    searchingActiveBorderColor:
      - '${C[base09]}'
      - bold
    optionsTextColor:
      - '${C[base04]}'
    selectedLineBgColor:
      - '${C[base02]}'
    cherryPickedCommitBgColor:
      - '${C[base0A]}'
    cherryPickedCommitFgColor:
      - '${C[base00]}'
    unstagedChangesColor:
      - '${C[base08]}'
    defaultFgColor:
      - '${C[base05]}'
  commitLength:
    show: true
  showListFooter: false
  fileTreeSortOrder: mixed
  showNumstatInFilesView: true
  showRandomTip: false
  showCommandLog: false
  showBottomLine: false
  showPanelJumps: true
  showDivergenceFromBaseBranch: arrowAndNumber
  filterMode: fuzzy
  statusPanelView: allBranchesLog
git:
  pagers:
    - colorArg: always
      pager: delta --paging=never
  branchLogCmd: git log --graph --color=always --abbrev-commit --decorate --date=relative --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(dim white)(%cr) %C(blue)<%an>%Creset' {{branchName}} --
  log:
    showWholeGraph: true
notARepository: quit
disableStartupPopups: true
EOF

# ---------------------------------------------------------------- is-fast
# is-fast has no config include/merge mechanism (single config.toml, no
# --config or multi-file support) so this can't be a separate generated file
# the way wezterm/delta split colors from hand-maintained settings. Instead,
# only the specific section.key pairs gen-palette owns are rewritten in
# place; any other section (e.g. hand-added [search], [selectors], [syntax])
# is left untouched no matter what's added there later.
isfast_cfg="$repo/config/is-fast/config.toml"
mkdir -p "$(dirname "$isfast_cfg")"
[[ -f "$isfast_cfg" ]] || cat >"$isfast_cfg" <<'EOF'
# config/is-fast/config.toml
# Color keys under [display]/[history]/[styles.*] are owned and rewritten by
# scripts/gen-palette — edit config/palettes/<name>.lua instead. Every other
# section here is yours; gen-palette never touches keys outside the ones it
# owns.

[display]
border_color = "#000000"

[history]
title_color = "#000000"
url_color = "#000000"
time_color = "#000000"
text_color = "#000000"

[styles.a]
fg = "#000000"

[styles.img]
fg = "#000000"
bold = true

[styles.blockquote]
fg = "#000000"
italic = true

[styles.mark]
fg = "#000000"
bg = "#000000"

[styles.kbd]
fg = "#000000"
bg = "#000000"

[styles.var]
fg = "#000000"
italic = true

[styles.samp]
fg = "#000000"

[styles.small]
fg = "#000000"

[styles.sub]
fg = "#000000"

[styles.sup]
fg = "#000000"

[styles.dd]
fg = "#000000"
EOF

python3 - "$isfast_cfg" \
  "${C[base0A]}" "${C[base04]}" "${C[base09]}" "${C[base0C]}" "${C[base0D]}" \
  "${C[base08]}" "${C[base03]}" "${C[base00]}" "${C[base02]}" "${C[base0E]}" <<'PYEOF'
import re, sys

path = sys.argv[1]
b0A, b04, b09, b0C, b0D, b08, b03, b00, b02, b0E = sys.argv[2:12]

# (section, key) -> new value; only these exact pairs are ever rewritten.
owned = {
    ("display", "border_color"): b0A,
    ("history", "title_color"): b0A,
    ("history", "url_color"): b04,
    ("history", "time_color"): b09,
    ("history", "text_color"): b0C,
    ("styles.a", "fg"): b0D,
    ("styles.img", "fg"): b08,
    ("styles.blockquote", "fg"): b03,
    ("styles.mark", "fg"): b00,
    ("styles.mark", "bg"): b0A,
    ("styles.kbd", "fg"): b00,
    ("styles.kbd", "bg"): b02,
    ("styles.var", "fg"): b08,
    ("styles.samp", "fg"): b0E,
    ("styles.small", "fg"): b04,
    ("styles.sub", "fg"): b04,
    ("styles.sup", "fg"): b04,
    ("styles.dd", "fg"): b04,
}

section_re = re.compile(r"^\[([^\]]+)\]\s*$")
kv_re = re.compile(r'^(\s*)(\w+)(\s*=\s*)"([^"]*)"(.*)$')

lines = open(path).read().splitlines(keepends=True)
section = None
for i, line in enumerate(lines):
    m = section_re.match(line.rstrip("\n"))
    if m:
        section = m.group(1)
        continue
    m = kv_re.match(line.rstrip("\n"))
    if m and section is not None and (section, m.group(2)) in owned:
        indent, key, sep, _old, rest = m.groups()
        newval = owned[(section, key)]
        lines[i] = f'{indent}{key}{sep}"{newval}"{rest}\n'

open(path, "w").writelines(lines)
PYEOF

# ---------------------------------------------------------------- superfile
mkdir -p "$repo/config/superfile/theme"
cat >"$repo/config/superfile/theme/dotfiles.toml" <<EOF
# Generated by scripts/gen-palette from config/palettes/$name.lua — do not edit by hand.

code_syntax_highlight = "monokai"

#-- Full Screen
full_screen_fg = "${C[base05]}"
full_screen_bg = "${C[base00]}"

#-- Gradient
gradient_color = ["${C[base0A]}", "${C[base09]}"]

#-- File Panel
file_panel_fg = "${C[base05]}"
file_panel_bg = "${C[base00]}"
file_panel_border = "${C[base02]}"
file_panel_border_active = "${C[base0A]}"
file_panel_top_directory_icon = "${C[base0A]}"
file_panel_top_path = "${C[base0D]}"
file_panel_item_selected_fg = "${C[base00]}"
file_panel_item_selected_bg = "${C[base0A]}"

#-- Footer
footer_fg = "${C[base05]}"
footer_bg = "${C[base00]}"
footer_border = "${C[base02]}"
footer_border_active = "${C[base0A]}"

#-- Sidebar
sidebar_fg = "${C[base05]}"
sidebar_bg = "${C[base00]}"
sidebar_title = "${C[base0A]}"
sidebar_border = "${C[base02]}"
sidebar_border_active = "${C[base0A]}"
sidebar_item_selected_fg = "${C[base00]}"
sidebar_item_selected_bg = "${C[base0A]}"
sidebar_divider = "${C[base03]}"

#-- Modals
modal_fg = "${C[base05]}"
modal_bg = "${C[base00]}"
modal_border_active = "${C[base0A]}"
modal_cancel_fg = "${C[base00]}"
modal_cancel_bg = "${C[base03]}"
modal_confirm_fg = "${C[base00]}"
modal_confirm_bg = "${C[base0A]}"

#-- Help Menu
help_menu_hotkey = "${C[base0A]}"
help_menu_title = "${C[base0A]}"

#-- Special
cursor = "${C[base0A]}"
correct = "${C[base0B]}"
error = "${C[base08]}"
hint = "${C[base0D]}"
cancel = "${C[base03]}"
EOF

# ---------------------------------------------------------------- shell prompts (zsh + bash)
mkdir -p "$repo/config/zsh"
{
  echo "# Generated by scripts/gen-palette from config/palettes/$name.lua — do not edit by hand."
  echo "# HEX vars for zsh (%F{\$VAR}), RGB vars for bash (\\e[38;2;\${VAR}m)."
  for k in base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F; do
    upper="${k^^}"
    printf 'export P_%s_HEX="%s"\n' "$upper" "${C[$k]}"
    printf 'export P_%s_RGB="%s"\n' "$upper" "${R[$k]}"
  done
} >"$repo/config/zsh/palette.zsh"

log_ok "wrote nvim, fzf, wezterm, delta, lazygit, is-fast, superfile, zsh palette ($name)"
