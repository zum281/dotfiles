# =============================================================================
# SHARED GIT CONFIG - Synced via dotfiles
# =============================================================================
#
# HOW TO USE:
# Add this to ~/.gitconfig:
#    [include]
#        path = ~/.gitconfig-shared
#
# =============================================================================

[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[rebase]
	updateRefs = true
