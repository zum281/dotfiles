# =============================================================================
# SHARED GIT CONFIG - Synced via dotfiles
# =============================================================================
#
# HOW TO USE:
# Add this to ~/.gitconfig:
#    [include]
#        path = ~/.gitconfig-shared
#
# =============================================================================

[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[rebase]
	updateRefs = true
[status]
    short = true
    branch = true
    showStash = true
[alias]
    st = status
    d = diff
    ds = diff --staged
    l = log --oneline --graph --decorate -20
